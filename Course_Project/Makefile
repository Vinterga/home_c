# ОПРЕДЕЛЕНИЕ КОМПИЛЯТОРА
CC = gcc

# ОПРЕДЕЛЕНИЕ ФЛАГОВ КОМПИЛЯЦИИ
CFLAGS = -Wall -Wextra -std=c11
# -Wall: включить ВСЕ основные предупреждения компилятора
# -Wextra: включить ДОПОЛНИТЕЛЬНЫЕ предупреждения
# -std=c11: использовать стандарт языка C11 (современный стандарт)

# ОПРЕДЕЛЕНИЕ ИМЕНИ ИСПОЛНЯЕМОГО ФАЙЛА
TARGET = temp_stats
# Имя файла, который будет создан после компиляции

# ОПИСАНИЕ ЦЕЛИ ПО УМОЛЧАНИЮ (при запуске просто `make`)
all: $(TARGET)
# Когда пользователь вводит `make`, выполняется эта цель
# Она зависит от $(TARGET), поэтому сначала будет выполнена цель $(TARGET)

# ПРАВИЛО СБОРКИ ИСПОЛНЯЕМОГО ФАЙЛА
$(TARGET): report.o temp_functions.o
# Цель $(TARGET) зависит от двух объектных файлов
# Если report.o или temp_functions.o изменились, нужно пересобрать $(TARGET)
	$(CC) $(CFLAGS) -o $(TARGET) report.o temp_functions.o
# Команда сборки: компилятор + флаги + выходной файл + объектные файлы
# $@ автоматически заменяется на имя цели ($(TARGET))
# $^ автоматически заменяется на все зависимости (report.o temp_functions.o)

# ПРАВИЛО КОМПИЛЯЦИИ report.c В report.o
report.o: report.c temp_functions.h
# report.o зависит от report.c и temp_functions.h
# Если любой из этих файлов изменился, нужно перекомпилировать report.o
	$(CC) $(CFLAGS) -c report.c
# -c: компилировать без линковки (создать только объектный файл)

# ПРАВИЛО КОМПИЛЯЦИИ temp_functions.c В temp_functions.o
temp_functions.o: temp_functions.c temp_functions.h
	$(CC) $(CFLAGS) -c temp_functions.c

# ЦЕЛЬ ДЛЯ ОЧИСТКИ ПРОЕКТА
clean:
# Удаляет все скомпилированные файлы
	rm -f *.o $(TARGET)
# rm -f: удалить файлы без подтверждения
# *.o: все файлы с расширением .o (объектные файлы)
# $(TARGET): исполняемый файл

# ОБЪЯВЛЕНИЕ ФИКТИВНЫХ ЦЕЛЕЙ
.PHONY: all clean
# Сообщает make, что all и clean не являются реальными файлами
# Это предотвращает потенциальные конфликты, если вдруг появятся файлы с такими именами